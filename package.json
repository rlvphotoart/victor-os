{
  "name": "victor-os",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b tsconfig.app.json tsconfig.node.json tsconfig.worker.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b tsconfig.app.json tsconfig.node.json tsconfig.worker.json --pretty false",
    "dev:worker": "wrangler dev --local",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write src tests vite.config.ts eslint.config.js tailwind.config.js postcss.config.js package.json README.md",
    "format:check": "prettier --check src tests vite.config.ts eslint.config.js tailwind.config.js postcss.config.js package.json README.md"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.10.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vite-plugin-pwa": "^1.1.0",
    "vitest": "^5.0.2",
    "wrangler": "^4.141.0"
  }
}
